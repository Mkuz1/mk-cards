{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mkcards",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  // node-forge (signs Apple Wallet passes) expects a few Node.js built-ins.
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "node scripts/build-assets.mjs" },
  // The database: a SQLite-backed Durable Object that lives inside this Worker.
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "Store" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],
  // Workers AI reads photographed business cards and badges.
  "ai": { "binding": "AI" }
}
